
# Parametros de esta instancia. VERSION e IMAGE_NAME los actualiza
# docker/build_image.sh (los lee de project.clj, unica fuente de verdad
# para la version) en cada build; el resto se edita a mano aqui, una sola
# vez por instancia, y data/start.sh los lee con `source` para no tener
# que hardcodearlos.
VERSION=4.1.0
IMAGE_NAME=robot
CONTAINER_NAME=robot
TIMEZONE=GMT-6:00
MININUM_MEMORY=1G
MAXIMUM_MEMORY=3G
HTTPS_PORT=14050
HTTP_PORT=18050
# IPs adicionales del host donde se publican HTTPS_PORT/HTTP_PORT; 127.0.0.1
# siempre esta incluida. Vacio o ausente = solo loopback. Si no, IPs
# separadas por comas (ej. la IP de ZeroTier de este host:
# 192.0.2.5,192.0.2.10). Tienen que ser IPs literales, no nombres: docker
# rechaza cualquier cosa que no parsee como IP.
# 0.0.0.0 es valido y expone la API en TODAS las interfaces, incluida la
# publica. ufw no filtra puertos publicados por docker, asi que ponerlo
# aqui deja la API abierta a internet.
BIND_EXTRA_IPS=
